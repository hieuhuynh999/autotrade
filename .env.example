# paper: mô phỏng trên máy, không đặt lệnh
# demo: đặt lệnh trên Binance Futures Demo (https://demo.binance.com)
MODE=paper
SYMBOL=BTCUSDT
INTERVAL=1h
LOOKBACK=24
ENTRY_THRESHOLD=0.015
EXIT_THRESHOLD=0.0
POSITION_PCT=0.10
STOP_PCT=0.02
DAILY_LOSS_PCT=0.03
MAX_ABS_FUNDING=0.0003
FEE_RATE=0.0005
PAPER_CASH=10000
LEVERAGE=1
LOOP_SECONDS=60
DB_PATH=data/trader.db

# Chỉ điền key tạo tại https://demo.binance.com
# Không dán key của sàn Binance thật. Tool từ chối mọi host khác demo-fapi.
BINANCE_API_KEY=
BINANCE_API_SECRET=
