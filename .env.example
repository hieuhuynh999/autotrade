# paper: mô phỏng trên máy, không đặt lệnh
# demo: đặt lệnh trên OKX Demo Trading (https://www.okx.com/demo-trading)
MODE=paper
SYMBOL=BTCUSDT
INTERVAL=15m
LOOKBACK=24
# Vào lệnh khi đóng cửa phá đỉnh hoặc phá đáy LOOKBACK nến. ENTRY_THRESHOLD không còn dùng để vào lệnh.
ENTRY_THRESHOLD=0.015
EXIT_THRESHOLD=0.0
POSITION_PCT=0.10
STOP_PCT=0.02
DAILY_LOSS_PCT=0.03
# Lãi ngày 50 USD thì đóng vị thế, tính ngày mới từ lúc đó và trade tiếp.
# Lỗ ngày 20 USD thì nghỉ mở lệnh mới 4 giờ. Hai mốc này nằm trong code, không sửa ở đây.
MAX_ABS_FUNDING=0.0003
FEE_RATE=0.0005
PAPER_CASH=10000
LEVERAGE=1
LOOP_SECONDS=60
DB_PATH=data/trader.db

# Chỉ điền key tạo trong OKX Demo Trading. Không dán key OKX thật và không dán key Binance.
# Tool chỉ gọi https://openapi.okx.com và luôn gửi header demo.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
