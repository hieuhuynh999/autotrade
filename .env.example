# paper: mô phỏng trên máy, không đặt lệnh
# demo: đặt lệnh trên Binance Futures Demo (https://demo.binance.com)
MODE=paper
SYMBOL=BTCUSDT
INTERVAL=15m
LOOKBACK=24
# Vào lệnh khi đóng cửa phá đỉnh hoặc phá đáy LOOKBACK nến. ENTRY_THRESHOLD không còn dùng để vào lệnh.
ENTRY_THRESHOLD=0.015
EXIT_THRESHOLD=0.0
POSITION_PCT=0.10
STOP_PCT=0.02
DAILY_LOSS_PCT=0.03
# Lãi ngày 50 USD thì đóng vị thế, tính ngày mới từ lúc đó và trade tiếp.
# Lỗ ngày 20 USD thì nghỉ mở lệnh mới 4 giờ. Hai mốc này nằm trong code, không sửa ở đây.
MAX_ABS_FUNDING=0.0003
FEE_RATE=0.0005
PAPER_CASH=10000
LEVERAGE=1
LOOP_SECONDS=60
DB_PATH=data/trader.db

# Chỉ điền key tạo tại https://demo.binance.com
# Không dán key của sàn Binance thật. Tool từ chối mọi host khác demo-fapi.
BINANCE_API_KEY=
BINANCE_API_SECRET=
